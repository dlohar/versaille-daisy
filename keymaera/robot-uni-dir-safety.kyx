ArchiveEntry "Versaille-Daisy/ROBOT-UNI-DIR-SAFETY"
ProgramVariables  
  Real px;
  Real py;
  Real vx;
  Real vy;
  Real c;
End.  
Definitions
  /* Maximal cycle time */
  Real T;
  /* Maximal velocity */
  Real V;
  
  /* X boundary */
  Real maxX;
  /* Y boundary */
  Real maxY;
  
  Bool inBoundary(Real x, Real y) <-> (0 <= x & x <= maxX & 0 <= y & y <= maxY);
  Bool velRange(Real vx, Real vy) <-> (0 <= vx & vx <= V & 0 <= vy & vy <= V);
  Bool envConditions <-> (T>0 & V > 0 & maxX > 0 & maxY > 0);
End.
Problem
inBoundary(px,py) &
envConditions
->
[{
    {
        /* DRIVE */
        vx := *;
        vy := *;
        ?(
            velRange(vx,vy) &
            inBoundary(
                px + T*vx,
                py + T*vy
            )
        );
    };
    {
        c:=0;
        {px'=vx,py'=vy, c'=1 & c<=T};
    }
}*@invariant(inBoundary(px,py))
] inBoundary(px,py)

End.
Tactic "Proof"
auto
End.
End.