ArchiveEntry "Versaille-Daisy/ACC-Not-Robust"
Definitions
Bool extra(Real deltaV) <-> (deltaV > 0);
Bool inv1(Real rPos, Real rVel, Real A, Real B, Real T) <-> (rPos>rVel^2/(2*A) & rPos > 0 & T > 0 & A > 0 & B > 0);
Bool inv(Real rPos, Real rVel, Real A, Real B, Real T, Real deltaV) <-> (inv1(rPos, rVel, A, B, T) & extra(deltaV));
Bool ctrl(Real rPos, Real rVel, Real rAccpost, Real A, Real B, Real T) <-> (
    rAccpost = A |
    rAccpost >= -B &
    rAccpost  <  A &
    rAccpost != 0 &
    (
      (-rVel / rAccpost > T | -rVel / rAccpost  <  0) &
      rPos + rVel * T + rAccpost * T^2 / 2 > (rVel + rAccpost * T)^2 / (2 * A) |
      rPos + rVel * T + rAccpost * T^2 / 2 > (rVel + rAccpost * T)^2 / (2 * A) &
      rPos - rVel^2 / rAccpost + rVel^2 / (2 * rAccpost) > 0
    ) |
    rPos + rVel * T > rVel^2 / (2 * A) &
    rAccpost = 0
);
End.
ProgramVariables
  Real rPos;
  Real A;
  Real B;
  Real T;
  Real rVel;
  Real rAccpost;
  Real deltaV;
  Real epsilonV;
End.  
Problem
!(
\exists deltaV (
deltaV > 0 &
\forall T (
\forall A (
\forall B (
\forall rPos (
\forall rVel (
    \exists rAccpost (
        \forall epsilonA (
            inv(rPos, rVel, A, B, T, deltaV) -> (
                ctrl(rPos, rVel, rAccpost, A, B, T) & (
                    (deltaV <= epsilonA & (epsilonA <= deltaV) -> ctrl(rPos, rVel, rAccpost+epsilonA, A, B, T))
                )
            )
        )
    )
)
)
)
)
)
)
)
End.
Tactic 
expandAllDefs();
notExists('R=="!\exists deltaV (deltaV>0&\forall T \forall A \forall B \forall rPos \forall rVel \exists rAccpost \forall epsilonA ((rPos>rVel^2/(2*A)&rPos>0&T>0&A>0&B>0)&deltaV>0->(rAccpost=A|rAccpost>=-B&rAccpost < A&rAccpost!=0&((-rVel/rAccpost>T|-rVel/rAccpost < 0)&rPos+rVel*T+rAccpost*T^2/2>(rVel+rAccpost*T)^2/(2*A)|rPos+rVel*T+rAccpost*T^2/2>(rVel+rAccpost*T)^2/(2*A)&rPos-rVel^2/rAccpost+rVel^2/(2*rAccpost)>0)|rPos+rVel*T>rVel^2/(2*A)&rAccpost=0)&(deltaV<=epsilonA&epsilonA<=deltaV->rAccpost+epsilonA=A|rAccpost+epsilonA>=-B&rAccpost+epsilonA < A&rAccpost+epsilonA!=0&((-rVel/(rAccpost+epsilonA)>T|-rVel/(rAccpost+epsilonA) < 0)&rPos+rVel*T+(rAccpost+epsilonA)*T^2/2>(rVel+(rAccpost+epsilonA)*T)^2/(2*A)|rPos+rVel*T+(rAccpost+epsilonA)*T^2/2>(rVel+(rAccpost+epsilonA)*T)^2/(2*A)&rPos-rVel^2/(rAccpost+epsilonA)+rVel^2/(2*(rAccpost+epsilonA))>0)|rPos+rVel*T>rVel^2/(2*A)&rAccpost+epsilonA=0)))");
